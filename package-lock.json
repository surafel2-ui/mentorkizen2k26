import fs from 'fs';

function run() {
  const content = fs.readFileSync('fetched_source.js', 'utf8');

  // Let's find patterns like:
  // "const PT =" or "PT =" or search the imports section at the top of the bundle.
  // In a Vite build, external imports are often compiled as e.g. "import { ... } from './assets/...'" or they are bundled.
  // Since we have react, motion, lucide-react, etc., let's look for how they are mapped in the bundle.
  
  // Let's get the first 10,000 chars of the file, or search for the variable names specifically.
  const names = ['PT', 'dc', 'pf', 'jo', 'df', 'Tt', 'Hy'];
  for (const name of names) {
    const regex = new RegExp(`b\\b.*\\b${name}\\b|\\b${name}\\s*=`, 'g');
    console.log(`\n=== Matches for ${name} ===`);
    let idx = -1;
    while ((idx = content.indexOf(` ${name} =`, idx + 1)) !== -1) {
      console.log(content.slice(idx - 60, idx + 200));
    }
    idx = -1;
    while ((idx = content.indexOf(` ${name}=`, idx + 1)) !== -1) {
      console.log(content.slice(idx - 60, idx + 200));
    }
    idx = -1;
    while ((idx = content.indexOf(`const ${name}`, idx + 1)) !== -1) {
      console.log(content.slice(idx - 20, idx + 200));
    }
  }
}

run();
