import fs from 'fs';

function run() {
  const content = fs.readFileSync('fetched_source.js', 'utf8');

  // We are looking for where Wp, e4, Uc, Jp, Kp, Pp, DT are assigned as Lucide icons.
  const searchTerms = ['Wp', 'e4', 'Uc', 'Jp', 'Kp', 'Pp', 'DT'];
  
  for (const term of searchTerms) {
    const patterns = [
      `${term}=Ut("`,
      `${term}=Ut(`,
      `${term} = Ut("`,
      `${term} = Ut(`
    ];
    console.log(`\n=== Matches for ${term} ===`);
    for (const pat of patterns) {
      let idx = 0;
      while ((idx = content.indexOf(pat, idx)) !== -1) {
        console.log(content.slice(idx, idx + 150));
        idx += pat.length;
      }
    }
  }
}

run();
